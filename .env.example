PORT=4173
HOST=127.0.0.1

# Primary local chat provider. The browser tries Grok first when this key is set.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_TOKENS=280

# Optional fallback / SNS drafting provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_VOICE=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=320

# SNS monitor / operator alerts.
CHAEA_API_BASE=http://127.0.0.1:4173
SNS_POLL_INTERVAL_MS=60000
OPERATOR_EMAIL=
RESEND_API_KEY=
RESEND_FROM=ChaeA Ops <onboarding@resend.dev>
